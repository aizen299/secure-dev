# Copy to .env and replace every value. .env is gitignored (CLAUDE.md §15.2).
# These are local development placeholders, not real credentials.

# --- PostgreSQL ---
POSTGRES_USER=secureops
POSTGRES_PASSWORD=replace-me-with-a-local-dev-password
POSTGRES_DB=secureops

# --- Redis ---
REDIS_PASSWORD=replace-me-with-a-local-dev-password

# --- API ---
#
# Three different port settings appear in this file. They are not the same
# thing, and getting them confused is easy:
#
#   SECUREOPS_HTTP_ADDR  the address the API process BINDS. Compose overrides
#                        this to :8080 inside the container, so the value here
#                        applies only when running the API directly on the host
#                        (go run ./cmd/api).
#   API_PORT             the HOST port Compose publishes, mapped to the
#                        container's 8080.
#   SECUREOPS_API_URL    where a CLIENT reaches the API.
#
# A note on :8080 specifically. Go binds ":8080" as [::]:8080, the dual-stack
# wildcard, which SUCCEEDS even when another process already holds
# 127.0.0.1:8080 -- the two sockets do not collide. The result is split-brain
# routing: localhost:8080 reaches this API while 127.0.0.1:8080 reaches the
# other process. Nothing fails loudly. If you run anything else on 8080
# (Jenkins is a common one), keep these settings off it, as they are here.
#
# Change SECUREOPS_HTTP_ADDR, API_PORT, and SECUREOPS_API_URL together: they
# are only correct when their ports agree.

SECUREOPS_ENV=development
SECUREOPS_HTTP_ADDR=:8090
SECUREOPS_LOG_LEVEL=info
SECUREOPS_LOG_FORMAT=text
SECUREOPS_DATABASE_URL=postgres://secureops:replace-me-with-a-local-dev-password@localhost:5432/secureops?sslmode=disable
SECUREOPS_REDIS_URL=redis://:replace-me-with-a-local-dev-password@localhost:6379/0

# Interim API credentials (docs/adr/006-interim-bearer-token-auth.md), as
# comma-separated label:secret pairs. The label identifies the client in the
# audit log; the secret must be at least 32 characters, and the API refuses to
# start if it is shorter or absent.
#
# Generate one with:  openssl rand -hex 32
SECUREOPS_API_TOKENS=local-admin:admin:replace-me-with-openssl-rand-hex-32,ci:service:replace-me-with-a-second-random-secret

# --- Repository fetching (worker only) ---
#
# The worker clones repository targets into an ephemeral workspace. These are
# resource limits on untrusted content, not tuning knobs: exceeding one is a
# structured scan failure. See docs/adr/008-repository-fetching.md.
SECUREOPS_FETCH_TIMEOUT=10m
SECUREOPS_FETCH_MAX_BYTES=2147483648
SECUREOPS_FETCH_MAX_FILES=500000

# --- Web ---
SECUREOPS_API_URL=http://localhost:8090

# --- Host port mappings (change if a port is already in use locally) ---
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8090
WEB_PORT=3000

# OWASP ZAP (DAST). Not on PATH in a default install: on macOS ZAP lives
# inside /Applications/ZAP.app. Leave empty to use "zap.sh" from PATH.
SECUREOPS_ZAP_DIR=/var/cache/zap
SECUREOPS_ZAP_COMMAND=

# --- Dashboard (apps/web) ---------------------------------------------------
#
# The dashboard's own API credential: the SECRET alone, meaning the third field
# of a label:role:secret entry in SECUREOPS_API_TOKENS above -- not the whole
# triple. It reads the API server-side and the secret never reaches the browser
# (ADR 027).
#
# The role must be `service` for the URL bar to submit scans (ADR 029), and
# deliberately not `admin`: the dashboard must not be able to edit the policy
# that judges the scans it queues. A `viewer` secret still works if you want the
# older read-only posture -- the URL bar then reports the API's own 403.
SECUREOPS_DASHBOARD_TOKEN=replace-with-the-dashboard-token-secret

# The dashboard login (ADR 029). One shared password, exchanged for a signed
# session cookie. This authenticates a browser, not a person -- per-user
# identity is Phase 11.
#
# Leaving this unset means nobody can sign in. That is the intended failure
# mode: an unset password must never read as "let everyone in".
SECUREOPS_DASHBOARD_PASSWORD=replace-with-a-dashboard-login-password

# Signs the session cookie (HMAC-SHA256). Optional: unset generates one per
# process, so every restart signs everyone out. That is a safe default but not
# a usable one beyond a single local container -- two replicas would not share
# sessions. Generate with: openssl rand -hex 32
SECUREOPS_DASHBOARD_SESSION_KEY=
