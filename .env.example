# Copy to .env and replace every value. .env is gitignored (CLAUDE.md §15.2).
# These are local development placeholders, not real credentials.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=secureops
POSTGRES_PASSWORD=replace-me-with-a-local-dev-password
POSTGRES_DB=secureops

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=replace-me-with-a-local-dev-password

# --- API credentials ---------------------------------------------------------
#
# label:role:scope:secret, comma-separated (ADR 006, ADR 023, ADR 033).
#
#   label   names the client in logs and in the audit trail
#   role    viewer | service | admin  -- WHAT it may do
#   scope   * for every project, or a comma-separated list of project slugs
#           -- WHERE it may do it
#   secret  the bearer token itself, 32 characters or more
#
# Both the role and the scope are required. A missing field is refused at
# startup rather than defaulted, because a default of admin or * would leave a
# credential more powerful than intended while the deployment kept working and
# noticed nothing (T-23).
#
# Generate a secret with:  openssl rand -hex 32
SECUREOPS_API_TOKENS=local-admin:admin:*:replace-me-with-openssl-rand-hex-32,ci:service:payments-api:replace-me-with-a-second-openssl-rand-hex-32

# Signs the session tokens the API issues at POST /api/v1/auth/login
# (ADR 033 §5a). Unset generates one per process, so a restart signs everyone
# out -- an acceptable default for one local container, and not what two API
# replicas would want. Generate with: openssl rand -hex 32
SECUREOPS_SESSION_KEY=

# People sign in with accounts, not with a shared password. Create the first one
# on the server; there is no sign-up page and no endpoint that works while the
# users table is empty:
#
#   echo -n 'a-long-password' | docker compose run --rm \
#     --entrypoint /usr/local/bin/useradd api -email you@example.com -role admin
#
# SECUREOPS_DASHBOARD_PASSWORD was ADR 029's shared password and is REMOVED. The
# dashboard refuses to start if it is still set, rather than ignoring it and
# leaving somebody believing a credential works.

# --- API ---------------------------------------------------------------------
#
# Three different port settings appear in this file. They are not the same
# thing, and confusing them is easy:
#
#   SECUREOPS_HTTP_ADDR  the address the API process BINDS. Compose overrides
#                        this to :8080 inside the container, so the value here
#                        applies only when running the API directly on the host
#                        (go run ./cmd/api).
#   API_PORT             the HOST port Compose publishes, mapped to the
#                        container's 8080.
#   SECUREOPS_API_URL    where a CLIENT reaches the API.
#
# A note on :8080 specifically. Go binds ":8080" as [::]:8080, the dual-stack
# wildcard, which SUCCEEDS even when another process already holds
# 127.0.0.1:8080 -- the two sockets do not collide. The result is split-brain
# routing: localhost:8080 reaches this API while 127.0.0.1:8080 reaches the
# other process. Nothing fails loudly. If you run anything else on 8080
# (Jenkins is a common one), keep these settings off it, as they are here.
#
# Change SECUREOPS_HTTP_ADDR, API_PORT, and SECUREOPS_API_URL together: they
# are only correct when their ports agree.

SECUREOPS_ENV=development
SECUREOPS_HTTP_ADDR=:8090
SECUREOPS_LOG_LEVEL=info
SECUREOPS_LOG_FORMAT=text
SECUREOPS_DATABASE_URL=postgres://secureops:replace-me-with-a-local-dev-password@localhost:5432/secureops?sslmode=disable
SECUREOPS_REDIS_URL=redis://:replace-me-with-a-local-dev-password@localhost:6379/0

# --- Dashboard (apps/web) ----------------------------------------------------
#
# The dashboard's own API credential: the SECRET alone, meaning the FOURTH field
# of a label:role:scope:secret entry above -- not the whole thing. It covers the
# reads that happen before anyone signs in; once a person signs in, their own
# session supersedes it, so their role and project membership apply to every
# read (ADR 033 §5a).
#
# The role must be `service` for the URL bar to submit scans (ADR 029), and
# deliberately not `admin`: the dashboard must not be able to edit the policy
# that judges the scans it queues. The secret never reaches the browser -- every
# read happens server-side (ADR 027).
SECUREOPS_DASHBOARD_TOKEN=replace-with-the-dashboard-token-secret

SECUREOPS_API_URL=http://localhost:8090

# --- Host port mappings (change if a port is already in use locally) ---------
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8090
WEB_PORT=3000

# --- Repository fetching (worker only) ---------------------------------------
#
# The worker clones repository targets into an ephemeral workspace. These are
# resource limits on untrusted content, not tuning knobs: exceeding one is a
# structured scan failure. See docs/adr/008-repository-fetching.md.
SECUREOPS_FETCH_TIMEOUT=10m
SECUREOPS_FETCH_MAX_BYTES=2147483648
SECUREOPS_FETCH_MAX_FILES=500000

# --- OWASP ZAP (worker only) -------------------------------------------------
#
# Where ZAP keeps its home directory inside the worker.
SECUREOPS_ZAP_DIR=/var/cache/zap

# In the worker image ZAP runs from its jar, because its launcher is bash and
# the container that executes untrusted content ships no general-purpose shell
# (ADR 030). The image sets SECUREOPS_ZAP_JAR itself.
#
# On a local checkout, point this at whatever launcher your ZAP install ships
# with. It is not on PATH in a default install -- on macOS ZAP lives inside
# /Applications/ZAP.app. Leave empty to use "zap.sh" from PATH; ZAP tests skip
# when it is unset.
SECUREOPS_ZAP_COMMAND=

# The JVM heap ceiling for a ZAP scan, as an -Xmx value. A fixed budget rather
# than ZAP's launcher heuristic, which sizes the heap from host memory and so
# makes a scan's memory ceiling a property of the machine (§14.3).
# SECUREOPS_ZAP_MAX_HEAP=1024m

# --- Container image scanning (worker only) ----------------------------------
#
# The largest image a scan may pull, in trivy's human-readable form ("2GB",
# "512MB"). §14's max artifact size, for the one scan path that fetches an
# artifact -- every other adapter reads bytes the fetch step already bounded.
#
# Empty uses the adapter's default of 2GB, matching SECUREOPS_FETCH_MAX_BYTES
# because both answer the same question: how much attacker-chosen content may a
# single scan pull.
#
# This bounds the COMPRESSED size the registry manifest declares. A layer that
# decompresses far larger is bounded only by the disk trivy extracts into (T-51).
# SECUREOPS_TRIVY_MAX_IMAGE_SIZE=2GB

# --- Optional: everything below has a working default ------------------------
#
# Allows scans of loopback, link-local and private addresses. Off by default:
# the SSRF policy exists to stop a submitted target reaching the internal
# network. Turn it on only for a deployment that legitimately scans its own
# network, and understand that it removes that control (T-04).
# SECUREOPS_ALLOW_PRIVATE_TARGETS=false

# Worker limits. Exceeding one is a structured failure, not a crash.
# SECUREOPS_WORKER_CONCURRENCY=2
# SECUREOPS_SCAN_JOB_TIMEOUT=30m
# SECUREOPS_SCANNER_TIMEOUT=10m
# SECUREOPS_SCANNER_MAX_OUTPUT_BYTES=134217728
# SECUREOPS_WORKSPACE_ROOT=/var/tmp/secureops

# Scanner data directories, provisioned at worker startup so a scan of an
# untrusted repository reaches no network at all (ADR 012).
# SECUREOPS_GRYPE_DB_DIR=/var/cache/grype
# SECUREOPS_SEMGREP_DIR=/var/cache/semgrep
# SECUREOPS_TRIVY_DIR=/var/cache/trivy

# API server tuning.
# SECUREOPS_DB_MAX_CONNS=10
# SECUREOPS_MAX_REQUEST_BYTES=1048576
# SECUREOPS_HTTP_READ_TIMEOUT=15s
# SECUREOPS_HTTP_WRITE_TIMEOUT=30s
# SECUREOPS_HTTP_IDLE_TIMEOUT=60s
# SECUREOPS_SHUTDOWN_TIMEOUT=15s
