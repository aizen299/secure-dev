{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go list:*)",
      "Bash(go version:*)",
      "Bash(go mod tidy)",
      "Bash(go mod verify)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint run:*)",
      "Bash(npm --prefix apps/web run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gitleaks:*)",
      "Bash(semgrep:*)",
      "Bash(syft:*)",
      "Bash(grype:*)",
      "Bash(trivy:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(docker compose down -v:*)"
    ]
  }
}
